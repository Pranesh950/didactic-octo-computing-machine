# StartupWiki Terminal — NVIDIA NIM API Configuration
# Copy this file to .env and fill in your values

# NVIDIA NIM API (free tier) — https://build.nvidia.com
VITE_API_BASE_URL=https://integrate.api.nvidia.com/v1
VITE_API_KEY=nvapi-...

# Primary model — Llama 3.3 70B (best available on free tier)
VITE_API_MODEL=meta/llama-3.3-70b-instruct

# Fallback model — Llama 3.1 8B (smaller, faster, still very capable)
# Automatically tried if the primary model fails
VITE_API_FALLBACK_MODEL=meta/llama-3.1-8b-instruct

VITE_API_MAX_TOKENS=4096
VITE_API_TEMPERATURE=0.0
