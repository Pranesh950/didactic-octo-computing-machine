# StartupWiki Terminal — Backend LLM Configuration
# Copy this to backend/.env and fill in your real API key

# NVIDIA NIM API (OpenAI-compatible)
# Get a free API key from https://build.nvidia.com/
# Keys start with "nvapi-"
LLM_API_KEY=nvapi-your-key-here

# Optional overrides (defaults shown below):
# LLM_API_BASE_URL=https://integrate.api.nvidia.com/v1
# LLM_PRIMARY_MODEL=meta/llama-3.1-70b-instruct
# LLM_FALLBACK_MODEL=meta/llama-3.1-8b-instruct
# LLM_MAX_TOKENS=4096
# LLM_TEMPERATURE=0.0
